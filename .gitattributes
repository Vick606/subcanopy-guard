# Normalize line endings to LF on commit, regardless of OS.
* text=auto eol=lf

# Python and shell scripts must use LF.
*.py text eol=lf
*.sh text eol=lf

# Windows-specific files keep CRLF if ever added.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch.
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Better diff hunk headers.
*.py diff=python
*.md diff=markdown

# Exclude vendored benchmarks and generated data from language stats.
vendor/** linguist-vendored
bench/corpus_agentdojo.jsonl linguist-generated
bench/results_scg.json linguist-generated
